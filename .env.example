# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env НЕ коммитится в репозиторий.

# Пароль базы данных для docker compose. На сервере придумайте длинный случайный пароль.
POSTGRES_PASSWORD="dev_password"

# Подключение к PostgreSQL.
# Локально через docker compose:   postgresql://student_account:dev_password@localhost:5432/student_account
DATABASE_URL="postgresql://student_account:dev_password@localhost:5432/student_account"

# Пароль тестовых аккаунтов для жюри (3 студента + деканаты). Импорт (npm run data:import)
# ставит его при каждом запуске. Если не задан — Hogwarts2026 (см. README).
# DEMO_PASSWORD="придумайте-свой"

# Логины тестовых студентов через запятую. Если не заданы — импорт выберет троих сам
# (факультеты №1–3 из students.csv, курсы 1–3, наименьший ID).
# TEST_STUDENT_LOGINS="larisa.sharova26,eva.orlova25,yaroslav.shestakov24"

# Папка с файлами вуза (students.csv, schedule.csv, campus-map.json). По умолчанию data/university.
# UNIVERSITY_DATA_DIR="data/university"

# Только для проверки продакшен-сборки по http://localhost (без HTTPS).
# На настоящем сервере с HTTPS не задавайте эту переменную.
# COOKIE_SECURE="false"

# Демо-режим публичного стенда: смена пароля демо-аккаунтов отключена.
DEMO_MODE="1"

# "1" — только если перед приложением стоит ваш прокси (Caddy/nginx), который выставляет X-Real-IP.
# Без прокси не включайте: иначе клиент сможет подставить любой адрес и обойти лимит попыток входа.
# TRUST_PROXY="1"
